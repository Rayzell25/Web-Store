# ===== TELEGRAM =====
# Token bot dari @BotFather
BOT_TOKEN=123456:ABC-DEF_yourtokenhere

# ID Telegram admin (boleh lebih dari satu, pisah dengan koma)
# Cek ID kamu lewat @userinfobot
ADMIN_IDS=123456789

# ===== DIGIFLAZZ (provider PPOB) =====
# Daftar di https://digiflazz.com lalu ambil di menu API
DIGIFLAZZ_USERNAME=your_digiflazz_username
DIGIFLAZZ_API_KEY=your_digiflazz_dev_or_prod_key
# Mode harga yang diambil: "prepaid" (pulsa/data/dll) - biarkan default
DIGIFLAZZ_MODE=prepaid

# ===== MARKUP / KEUNTUNGAN =====
# Markup default per transaksi (rupiah) yang ditambahkan ke harga modal Digiflazz
MARKUP_DEFAULT=500
# Markup khusus role RESELLER (rupiah)
MARKUP_RESELLER=250

# ===== TOP UP =====
# Info rekening/tujuan transfer manual yang ditampilkan ke user saat top up
TOPUP_INFO=BCA 1234567890 a.n. CHO STORE
# Nominal top up minimum
MIN_TOPUP=10000

# ===== TAMPILAN =====
STORE_NAME=Cho Store PPOB
MAINTENANCE_INFO=23:00 - 00:30 WIB
BOT_VPN_URL=https://t.me/your_vpn_bot
ADMIN_CONTACT=https://t.me/your_admin_username

# ===== LAINNYA =====
# Path database sqlite (relatif terhadap root project)
DB_PATH=data/ppob.db
